{
  "version": "2.1.0",
  "$schema": "http://json.schemastore.org/sarif-2.1.0-rtm.5",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ESLint",
          "informationUri": "https://eslint.org",
          "rules": [
            {
              "id": "max-params",
              "helpUri": "https://eslint.org/docs/latest/rules/max-params",
              "properties": {},
              "shortDescription": {
                "text": "Enforce a maximum number of parameters in function definitions"
              }
            },
            {
              "id": "no-unused-vars",
              "helpUri": "https://eslint.org/docs/latest/rules/no-unused-vars",
              "properties": {},
              "shortDescription": {
                "text": "Disallow unused variables"
              }
            },
            {
              "id": "no-eval",
              "helpUri": "https://eslint.org/docs/latest/rules/no-eval",
              "properties": {},
              "shortDescription": {
                "text": "Disallow the use of `eval()`"
              }
            },
            {
              "id": "max-lines-per-function",
              "helpUri": "https://eslint.org/docs/latest/rules/max-lines-per-function",
              "properties": {},
              "shortDescription": {
                "text": "Enforce a maximum number of lines of code in a function"
              }
            },
            {
              "id": "complexity",
              "helpUri": "https://eslint.org/docs/latest/rules/complexity",
              "properties": {},
              "shortDescription": {
                "text": "Enforce a maximum cyclomatic complexity allowed in a program"
              }
            },
            {
              "id": "@typescript-eslint/no-explicit-any",
              "helpUri": "https://typescript-eslint.io/rules/no-explicit-any",
              "properties": {},
              "shortDescription": {
                "text": "Disallow the `any` type"
              }
            },
            {
              "id": "max-depth",
              "helpUri": "https://eslint.org/docs/latest/rules/max-depth",
              "properties": {},
              "shortDescription": {
                "text": "Enforce a maximum depth that blocks can be nested"
              }
            }
          ],
          "version": "10.14.0"
        }
      },
