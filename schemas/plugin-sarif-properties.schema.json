{
  "$defs": {
    "Category": {
      "enum": [
        "quality",
        "architecture",
        "test",
        "sast",
        "dependency",
        "license",
        "secret",
        "iac",
        "health"
      ],
      "title": "Category",
      "type": "string"
    },
    "Cvss": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "vector": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Vector",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:2\\.0|3\\.0|3\\.1|4\\.0)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "vector",
        "score"
      ],
      "title": "Cvss",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "Valore misurato e soglia superata, per le regole di complessità e dimensione (ADR-0026).\n\nLi estrae l'adattatore dal messaggio del motore, dove stanno come testo (V-03).",
      "properties": {
        "threshold": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        },
        "value": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "threshold"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "$id": "urn:code-analyzer:schema:plugin-sarif-properties:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "secret"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "secret_sha256": {
            "type": "string"
          }
        },
        "required": [
          "secret_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "dependency"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "purl": {
            "type": "string"
          }
        },
        "required": [
          "purl"
        ]
      }
    }
  ],
  "properties": {
    "aliases": {
      "description": "Altri identificativi della stessa vulnerabilità (CVE, GHSA, ...).",
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Aliases",
      "type": "array",
      "uniqueItems": true
    },
    "category": {
      "anyOf": [
        {
          "$ref": "#/$defs/Category"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Categoria del finding. Obbligatoria se il manifest del plugin dichiara più categorie (oggi trivy): lo schema non lo esprime, lo controlla la normalizzazione."
    },
    "cvss": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cvss"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "license_spdx": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Identificativo o espressione SPDX.",
      "title": "License Spdx"
    },
    "metric": {
      "anyOf": [
        {
          "$ref": "#/$defs/Metric"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "purl": {
      "anyOf": [
        {
          "maxLength": 2048,
          "pattern": "^pkg:[a-z][a-z0-9.+-]*/\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purl"
    },
    "secret_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SHA-256 del valore del segreto (ADR-0008), per il fingerprint. Non va propagato al report.",
      "title": "Secret Sha256"
    },
    "tool_severity": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Severità dichiarata dallo scanner, non normalizzata.",
      "title": "Tool Severity"
    }
  },
  "title": "PluginSarifProperties",
  "type": "object",
  "x-schema-version": "1.1"
}
