          }
        },
        {
          "if": {
            "properties": {
              "block_on": {
                "contains": {
                  "const": "alto"
                },
                "type": "array"
              }
            },
            "required": [
              "block_on"
            ]
          },
          "then": {
            "properties": {
              "warn_on": {
                "not": {
                  "contains": {
                    "const": "alto"
                  },
                  "type": "array"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "block_on": {
                "contains": {
                  "const": "medio"
                },
                "type": "array"
              }
            },
            "required": [
              "block_on"
            ]
          },
          "then": {
            "properties": {
              "warn_on": {
                "not": {
                  "contains": {
