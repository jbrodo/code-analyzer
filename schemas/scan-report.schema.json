  "$id": "urn:code-analyzer:schema:scan-report:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Un plugin `failed` rende `status` `partial` (un solo verso, anche nello schema).\n\nVincoli solo del modello: nomi in `plugins` unici e disgiunti da `disabled_plugins`.",
  "if": {
    "properties": {
      "plugins": {
        "contains": {
          "properties": {
            "outcome": {
              "const": "failed"
            }
          },
          "required": [
            "outcome"
          ]
        },
        "type": "array"
      }
    },
    "required": [
      "plugins"
    ]
  },
  "properties": {
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/Baseline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_version": {
      "anyOf": [
        {
          "pattern": "^[0-9]{1,4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Versione della tabella di correlazione usata (K-21): un gruppo assegnato con una tabella diversa non è confrontabile.",
      "title": "Correlation Version"
    },
    "disabled_plugins": {
      "description": "Disattivati da `plugins.disable`; disgiunti dai nomi in `plugins` (vincolo del modello, non dello schema).",
      "items": {
        "type": "string"
      },
      "title": "Disabled Plugins",
      "type": "array"
    },
    "duration_seconds": {
      "description": "Secondi.",
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "effective_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeAnalyzerConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Configurazione con cui la scansione è stata eseguita, per intero (ADR-0025): serve a una scansione di PR che usa questo report come baseline. Assente nei report della Fase 1, che quindi non valgono come baseline per la configurazione."
    },
    "enrichment": {
      "items": {
        "$ref": "#/$defs/EnrichmentSnapshot"
      },
      "maxItems": 2,
      "title": "Enrichment",
      "type": "array"
    },
    "exceptions": {
      "items": {
        "$ref": "#/$defs/AppliedException"
      },
      "title": "Exceptions",
      "type": "array"
    },
    "exclusions": {
      "description": "Glob effettivi: predefiniti più `paths.exclude`.",
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "gate": {
      "$ref": "#/$defs/ca_core__models__scan_report__Gate"
    },
    "inert_sections": {
      "items": {
        "$ref": "#/$defs/InertSection"
      },
      "title": "Inert Sections",
      "type": "array"
    },
    "plugins": {
      "description": "Nomi unici (vincolo del modello, non dello schema).",
      "items": {
        "$ref": "#/$defs/PluginRun"
      },
      "title": "Plugins",
      "type": "array"
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "scan": {
      "$ref": "#/$defs/ScanInfo"
    },
    "scoring": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScoringInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "service_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServiceContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReportStatus"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Warning_"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "version",
    "status",
    "started_at",
    "duration_seconds",
    "repository",
    "gate",
    "plugins",
    "findings"
  ],
  "then": {
    "properties": {
      "status": {
        "const": "partial"
      }
    }
  },
  "title": "ScanReport",
  "type": "object",
  "x-schema-version": "1.4"
}
