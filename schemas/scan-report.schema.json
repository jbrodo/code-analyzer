{
  "$defs": {
    "Agents": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "llm_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Provider"
        },
        "max_phase": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Phase"
        }
      },
      "title": "Agents",
      "type": "object"
    },
    "AppliedException": {
      "additionalProperties": false,
      "description": "Eccezione con fingerprint corrispondente e `expires` non superata (ADR-0014).",
      "properties": {
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "expires": {
          "format": "date",
          "title": "Expires",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "reason",
        "expires",
        "approved_by"
      ],
      "title": "AppliedException",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "description": "Esito del confronto con la baseline (ADR-0025, §7). I conteggi quadrano con i finding.",
      "properties": {
        "commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "existing": {
          "default": 0,
          "minimum": 0,
          "title": "Existing",
          "type": "integer"
        },
        "new": {
          "default": 0,
          "minimum": 0,
          "title": "New",
          "type": "integer"
        },
        "not_evaluated": {
          "default": 0,
          "description": "Finding della baseline che mancano perché il loro plugin è fallito: non sono né risolti né esistenti e il report lo dice (ADR-0025).",
          "minimum": 0,
          "title": "Not Evaluated",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Codice dell'avviso (`baseline-commit-mismatch`, `baseline-partial`...).",
          "title": "Reason"
        },
        "resolved": {
          "items": {
            "$ref": "#/$defs/ResolvedFinding"
          },
          "maxItems": 10000,
          "title": "Resolved",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineSourceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/BaselineStatus"
        },
        "updated": {
          "description": "Fingerprint degli `existing` con posizione o livello cambiati: il SARIF li marca `updated` (ADR-0011, ADR-0025).",
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Updated",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "BaselineSourceKind": {
      "enum": [
        "ci-artifact",
        "base-scan",
        "server"
      ],
      "title": "BaselineSourceKind",
      "type": "string"
    },
    "BaselineState": {
      "description": "Stato rispetto alla baseline (ADR-0025). Un finding `risolto` non è nel report: sta nella\nsezione `baseline` di `scan-report`. Assente: nessuna baseline valida.",
      "enum": [
        "new",
        "existing"
      ],
      "title": "BaselineState",
      "type": "string"
    },
    "BaselineStatus": {
      "enum": [
        "valid",
        "missing",
        "rejected"
      ],
      "title": "BaselineStatus",
      "type": "string"
    },
    "Category": {
      "enum": [
        "quality",
        "architecture",
        "test",
        "sast",
        "dependency",
        "license",
        "secret",
        "iac",
        "health"
      ],
      "title": "Category",
      "type": "string"
    },
    "CodeAnalyzerConfig": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "anyOf": [
            {
              "$ref": "#/$defs/Agents"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exceptions": {
          "items": {
            "$ref": "#/$defs/ConfigException"
          },
          "title": "Exceptions",
          "type": "array"
        },
        "gate": {
          "$ref": "#/$defs/ca_core__models__config__Gate"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "licenses": {
          "anyOf": [
            {
              "$ref": "#/$defs/Licenses"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "paths": {
          "$ref": "#/$defs/Paths"
        },
        "plugins": {
          "$ref": "#/$defs/Plugins"
        },
        "scoring": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scoring"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/Service"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "title": "CodeAnalyzerConfig",
      "type": "object"
    },
    "ConfigException": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "expires": {
          "format": "date",
          "title": "Expires",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "reason",
        "expires",
        "approved_by"
      ],
      "title": "ConfigException",
      "type": "object"
    },
    "CoverageFormat": {
      "enum": [
        "lcov",
        "cobertura"
      ],
      "title": "CoverageFormat",
      "type": "string"
    },
    "CoverageOptions": {
      "additionalProperties": false,
      "properties": {
        "reports": {
          "items": {
            "$ref": "#/$defs/CoverageReport"
          },
          "maxItems": 20,
          "title": "Reports",
          "type": "array"
        }
      },
      "title": "CoverageOptions",
      "type": "object"
    },
    "CoverageReport": {
      "additionalProperties": false,
      "description": "Un report prodotto dalla CI prima della scansione, come file del workspace.",
      "properties": {
        "base_dir": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "^(?:[/\\\\]|[A-Za-z]:)|(?:^|[/\\\\])\\.\\.(?![^/\\\\])"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Dir"
        },
        "format": {
          "$ref": "#/$defs/CoverageFormat"
        },
        "path": {
          "minLength": 1,
          "not": {
            "pattern": "^(?:[/\\\\]|[A-Za-z]:)|(?:^|[/\\\\])\\.\\.(?![^/\\\\])"
          },
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "format"
      ],
      "title": "CoverageReport",
      "type": "object"
    },
    "EnrichmentSnapshot": {
      "additionalProperties": false,
      "description": "Snapshot EPSS o KEV usato (ADR-0024): basta a riprodurre un punteggio a posteriori.",
      "properties": {
        "content": {
          "additionalProperties": {
            "maxLength": 128,
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Content",
          "type": "object"
        },
        "downloaded_at": {
          "format": "date-time",
          "title": "Downloaded At",
          "type": "string"
        },
        "feed": {
          "enum": [
            "epss",
            "kev"
          ],
          "title": "Feed",
          "type": "string"
        },
        "origin": {
          "enum": [
            "public",
            "mirror",
            "cache"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "feed",
        "origin",
        "downloaded_at",
        "sha256"
      ],
      "title": "EnrichmentSnapshot",
      "type": "object"
    },
    "FeedSnapshot": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "sync_failed": {
          "default": false,
          "description": "Sincronizzazione fallita: usato lo snapshot precedente.",
          "title": "Sync Failed",
          "type": "boolean"
        },
        "synced_at": {
          "format": "date-time",
          "title": "Synced At",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "synced_at"
      ],
      "title": "FeedSnapshot",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "baseline_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "correlation": {
          "anyOf": [
            {
              "pattern": "^cg1:[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gruppo di correlazione (K-21, ADR-0026): finding di strumenti diversi sullo stesso problema nello stesso file. Non cambia fingerprint, livello né esito del gate.",
          "title": "Correlation"
        },
        "cve": {
          "items": {
            "type": "string"
          },
          "title": "Cve",
          "type": "array"
        },
        "cwe": {
          "items": {
            "type": "string"
          },
          "title": "Cwe",
          "type": "array"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactFactors"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "level_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/LevelSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "license_spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Spdx"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "pathless_key": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Impronta degli ingredienti del fingerprint senza il percorso (ADR-0025): serve ad accoppiare un finding dopo un cambio di percorso. Non è un identificativo.",
          "title": "Pathless Key"
        },
        "previous_path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "not": {
                "pattern": "^(?:[/\\\\]|[A-Za-z]:)|(?:^|[/\\\\])\\.\\.(?![^/\\\\])|[\\x00-\\x1f\\x7f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Percorso nella baseline di un finding accoppiato dopo uno spostamento di file (ADR-0025, secondo passaggio). Solo con `baseline_state` `existing`.",
          "title": "Previous Path"
        },
        "remediation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Remediation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "aperto"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tool": {
          "description": "Primo di `tools` in ordine lessicografico (vincolo del modello, non dello schema).",
          "title": "Tool",
          "type": "string"
        },
        "tools": {
          "description": "Tutti i tool di origine.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tools",
          "type": "array",
          "uniqueItems": true
        },
        "variant_scores": {
          "description": "Punteggi in ombra di A e B (D2-10). Varianti uniche (vincolo del modello).",
          "items": {
            "$ref": "#/$defs/VariantScore"
          },
          "maxItems": 2,
          "title": "Variant Scores",
          "type": "array"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "category",
        "rule_id",
        "tool",
        "tools",
        "title",
        "message",
        "location",
        "first_seen",
        "last_seen"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GateMode": {
      "description": "Modo richiesto. Quello effettivo lo registra il report (ADR-0009, ADR-0025):\n`new-findings-only` vale come `all` su una scansione completa o senza baseline valida.",
      "enum": [
        "all",
        "new-findings-only"
      ],
      "title": "GateMode",
      "type": "string"
    },
    "HistoryCoverage": {
      "enum": [
        "full",
        "shallow",
        "absent"
      ],
      "title": "HistoryCoverage",
      "type": "string"
    },
    "ImpactFactors": {
      "additionalProperties": false,
      "properties": {
        "c": {
          "maximum": 1,
          "minimum": 0,
          "title": "C",
          "type": "number"
        },
        "e": {
          "maximum": 1,
          "minimum": 0,
          "title": "E",
          "type": "number"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "g": {
          "maximum": 1,
          "minimum": 0,
          "title": "G",
          "type": "number"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        },
        "variant": {
          "pattern": "^[AB]$",
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "g",
        "p",
        "e",
        "c",
        "variant"
      ],
      "title": "ImpactFactors",
      "type": "object"
    },
    "InertSection": {
      "description": "Sezioni di `.code-analyzer.yml` validate ma senza effetto in Fase 1 (ADR-0014).",
      "enum": [
        "service",
        "scoring",
        "agents"
      ],
      "title": "InertSection",
      "type": "string"
    },
    "Isolation": {
      "enum": [
        "gvisor",
        "hardened-container"
      ],
      "title": "Isolation",
      "type": "string"
    },
    "Level": {
      "enum": [
        "critico",
        "alto",
        "medio",
        "basso"
      ],
      "title": "Level",
      "type": "string"
    },
    "LevelSource": {
      "description": "IPOTESI D-0009-A: origine del livello provvisorio. Togliere con il campo `level_source`.",
      "enum": [
        "tool_severity",
        "policy",
        "default",
        "score",
        "override"
      ],
      "title": "LevelSource",
      "type": "string"
    },
    "Licenses": {
      "additionalProperties": false,
      "properties": {
        "distributed_product": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distributed Product"
        },
        "forbidden": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden",
          "type": "array"
        },
        "require_approval": {
          "items": {
            "type": "string"
          },
          "title": "Require Approval",
          "type": "array"
        }
      },
      "title": "Licenses",
      "type": "object"
    },
    "LinterOptions": {
      "additionalProperties": false,
      "description": "ADR-0026: il repository può solo spegnere regole; il report le elenca.",
      "properties": {
        "disable_rules": {
          "items": {
            "pattern": "^[A-Za-z0-9@][A-Za-z0-9_./@-]{0,127}$",
            "type": "string"
          },
          "maxItems": 500,
          "title": "Disable Rules",
          "type": "array"
        }
      },
      "title": "LinterOptions",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "dependency_path": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Path",
          "type": "array"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Non precedente a `start_line` (vincolo del modello, non dello schema).",
          "title": "End Line"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "purl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purl"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "required": [
        "repository"
      ],
      "title": "Location",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "ok",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Paths": {
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "items": {
            "minLength": 1,
            "not": {
              "pattern": "^(?:[/\\\\]|[A-Za-z]:)|(?:^|[/\\\\])\\.\\.(?![^/\\\\])"
            },
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        }
      },
      "title": "Paths",
      "type": "object"
    },
    "PluginRun": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "failure": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "duration_seconds": {
          "description": "Secondi.",
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "failure": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
