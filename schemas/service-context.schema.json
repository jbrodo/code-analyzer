{
  "$id": "urn:code-analyzer:schema:service-context:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Id"
    },
    "internet_facing": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Internet Facing"
    },
    "origin": {
      "anyOf": [
        {
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Chi ha prodotto il file, dichiarato da chi lo scrive.",
      "title": "Origin"
    },
    "tier": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier"
    },
    "version": {
      "description": "Versione del formato del file.",
      "maximum": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "ServiceContextFile",
  "type": "object",
  "x-schema-version": "1.0"
}
