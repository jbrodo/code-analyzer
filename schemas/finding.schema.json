{
  "$defs": {
    "BaselineState": {
      "description": "Stato rispetto alla baseline (ADR-0025). Un finding `risolto` non è nel report: sta nella\nsezione `baseline` di `scan-report`. Assente: nessuna baseline valida.",
      "enum": [
        "new",
        "existing"
      ],
      "title": "BaselineState",
      "type": "string"
    },
    "Category": {
      "enum": [
        "quality",
        "architecture",
        "test",
        "sast",
        "dependency",
        "license",
        "secret",
        "iac",
        "health"
      ],
      "title": "Category",
      "type": "string"
    },
    "ImpactFactors": {
      "additionalProperties": false,
      "properties": {
        "c": {
          "maximum": 1,
          "minimum": 0,
          "title": "C",
          "type": "number"
        },
        "e": {
          "maximum": 1,
          "minimum": 0,
          "title": "E",
          "type": "number"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "g": {
          "maximum": 1,
          "minimum": 0,
          "title": "G",
          "type": "number"
        },
        "p": {
          "maximum": 1,
          "minimum": 0,
          "title": "P",
          "type": "number"
        },
        "variant": {
          "pattern": "^[AB]$",
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "g",
        "p",
        "e",
        "c",
        "variant"
      ],
      "title": "ImpactFactors",
      "type": "object"
    },
    "Level": {
      "enum": [
        "critico",
        "alto",
        "medio",
        "basso"
      ],
      "title": "Level",
      "type": "string"
    },
    "LevelSource": {
      "description": "IPOTESI D-0009-A: origine del livello provvisorio. Togliere con il campo `level_source`.",
      "enum": [
        "tool_severity",
        "policy",
        "default",
        "score",
        "override"
      ],
      "title": "LevelSource",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "dependency_path": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Path",
          "type": "array"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Non precedente a `start_line` (vincolo del modello, non dello schema).",
          "title": "End Line"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "purl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purl"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "required": [
        "repository"
      ],
      "title": "Location",
      "type": "object"
    },
    "Remediation": {
      "additionalProperties": false,
      "description": "I passi per risolvere un finding (ADR-0029). Sempre testo semplice: né l'API né la UI lo\ninterpretano come HTML o Markdown. È della regola, non del risultato: nessun contenuto del\nrepository analizzato. Nessun testo generato (gli LLM sono della Fase 3).",
      "properties": {
        "references": {
          "items": {
            "pattern": "^https?://[^\\s\\x00-\\x1f\\x7f]{1,2040}$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "References",
          "type": "array",
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/RemediationSource"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "title": "Remediation",
      "type": "object"
    },
    "RemediationSource": {
      "enum": [
        "tool",
        "rule",
        "derived"
      ],
      "title": "RemediationSource",
      "type": "string"
    },
    "Status": {
      "enum": [
        "aperto",
        "in_corso",
        "accettato",
        "falso_positivo",
        "risolto"
      ],
      "title": "Status",
      "type": "string"
    },
    "VariantScore": {
      "additionalProperties": false,
      "description": "Punteggio in ombra di una variante (D2-10, ADR-0018): si calcolano A e B insieme, e ciascuna\nporta i suoi fattori con la loro evidenza. La forma esatta dei fattori è di ADR-0021 (A-06,\nancora da scrivere): qui solo ciò che ADR-0018 già fissa.",
      "properties": {
        "impact": {
          "$ref": "#/$defs/ImpactFactors"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "variant": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant",
        "score",
        "level",
        "impact"
      ],
      "title": "VariantScore",
      "type": "object"
    }
  },
  "$id": "urn:code-analyzer:schema:finding:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "correlation": {
      "anyOf": [
        {
          "pattern": "^cg1:[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Gruppo di correlazione (K-21, ADR-0026): finding di strumenti diversi sullo stesso problema nello stesso file. Non cambia fingerprint, livello né esito del gate.",
      "title": "Correlation"
    },
    "cve": {
      "items": {
        "type": "string"
      },
      "title": "Cve",
      "type": "array"
    },
    "cwe": {
      "items": {
        "type": "string"
      },
      "title": "Cwe",
      "type": "array"
    },
    "due_date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due Date"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "impact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImpactFactors"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "level": {
      "anyOf": [
        {
          "$ref": "#/$defs/Level"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "level_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/LevelSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "license_spdx": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Spdx"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "pathless_key": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Impronta degli ingredienti del fingerprint senza il percorso (ADR-0025): serve ad accoppiare un finding dopo un cambio di percorso. Non è un identificativo.",
      "title": "Pathless Key"
    },
    "previous_path": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "not": {
            "pattern": "^(?:[/\\\\]|[A-Za-z]:)|(?:^|[/\\\\])\\.\\.(?![^/\\\\])|[\\x00-\\x1f\\x7f]"
          },
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Percorso nella baseline di un finding accoppiato dopo uno spostamento di file (ADR-0025, secondo passaggio). Solo con `baseline_state` `existing`.",
      "title": "Previous Path"
    },
    "remediation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Remediation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "aperto"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "tool": {
      "description": "Primo di `tools` in ordine lessicografico (vincolo del modello, non dello schema).",
      "title": "Tool",
      "type": "string"
    },
    "tools": {
      "description": "Tutti i tool di origine.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Tools",
      "type": "array",
      "uniqueItems": true
    },
    "variant_scores": {
      "description": "Punteggi in ombra di A e B (D2-10). Varianti uniche (vincolo del modello).",
      "items": {
        "$ref": "#/$defs/VariantScore"
      },
      "maxItems": 2,
      "title": "Variant Scores",
      "type": "array"
    }
  },
  "required": [
    "id",
    "fingerprint",
    "category",
    "rule_id",
    "tool",
    "tools",
    "title",
    "message",
    "location",
    "first_seen",
    "last_seen"
  ],
  "title": "Finding",
  "type": "object",
  "x-schema-version": "1.2"
}
